# MySQL Database Connection
DB_HOST=152.53.205.236
DB_PORT=10146
DB_USER=mysql
DB_PASSWORD=
DB_NAME=mysql

# App port (dev server, preview and production server). Defaults to 3000.
PORT=3000

# Mail server (forgot-password emails). Leave SMTP_USERNAME / SMTP_PASSWORD empty to
# disable sending; the reset link is then only logged (and shown on the page in dev).
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Truong Thinh Phat

# Public address of the app (no trailing slash). Used for email links and to build
# image addresses (APP_URL/uploads/<key>). Restart the dev server / rebuild after editing.
APP_URL=http://localhost:3000
