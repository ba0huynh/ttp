{
  "name": "phn-mm-qun-l-xe-my-trng-thnh-pht",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.mjs",
    "build:start": "npm run build && npm run start",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "migration:run": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "docker:prod": "(docker rm -f moto-ttp || echo No container to remove) && docker build -t moto-ttp . && docker run -d --name moto-ttp -p 3001:3000 --env-file .env moto-ttp",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed/index.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@t3-oss/env-core": "^0.13.10",
